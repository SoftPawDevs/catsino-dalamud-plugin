{
  "contractVersion": "1.5.0",
  "serialization": {
    "propertyNames": "camelCase",
    "enums": "camelCaseStrings",
    "ids": "uuidStrings",
    "gil": "signedInt64",
    "percentages": "decimal",
    "timestamps": "utcDateTimeOffset"
  },
  "routes": [
    { "operation": "authorizeDealer", "method": "POST", "path": "/api/v1/dealers/authorize", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": "AuthorizeDealerRequest", "responseDto": "DealerAuthorizationDto" },
    { "operation": "refreshDealer", "method": "POST", "path": "/api/v1/dealers/refresh", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": "RefreshDealerRequest", "responseDto": "DealerAuthorizationDto" },
    { "operation": "disconnectDealer", "method": "POST", "path": "/api/v1/dealers/disconnect", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": "dealerDisconnect", "responseDto": null },
    { "operation": "createPluginPairing", "method": "POST", "path": "/api/v1/plugin/pairings", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": "PluginPairingRequest", "responseDto": "PluginPairingDto" },
    { "operation": "pluginHeartbeat", "method": "POST", "path": "/api/v1/plugin/pairings/{pairingId}/heartbeat", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": "PluginHeartbeatRequest", "responseDto": null },
    { "operation": "reportPayoutExecutorStatus", "method": "POST", "path": "/api/v1/payout-executor/status", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": "PayoutExecutorStatusDto", "responseDto": null },
    { "operation": "listGameSessions", "method": "GET", "path": "/api/v1/game-sessions", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": null, "responseDto": "GameSessionDto[]" },
    { "operation": "getActiveGameSession", "method": "GET", "path": "/api/v1/game-sessions/active", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": null, "responseDto": "GameSessionDto|null" },
    { "operation": "getGameSession", "method": "GET", "path": "/api/v1/game-sessions/{sessionId}", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": null, "responseDto": "GameSessionDto" },
    { "operation": "createGameSession", "method": "POST", "path": "/api/v1/game-sessions", "financialMutation": true, "idempotencyKeyRequired": true, "requestDto": "CreateGameSessionRequest", "responseDto": "GameSessionDto" },
    { "operation": "updateSessionFee", "method": "PATCH", "path": "/api/v1/game-sessions/{sessionId}/fee", "financialMutation": true, "idempotencyKeyRequired": true, "requestDto": "UpdateSessionFeeRequest", "responseDto": "GameSessionDto" },
    { "operation": "openGameSession", "method": "POST", "path": "/api/v1/game-sessions/{sessionId}/open", "financialMutation": true, "idempotencyKeyRequired": true, "requestDto": null, "responseDto": "GameSessionDto" },
    { "operation": "closeGameSession", "method": "POST", "path": "/api/v1/game-sessions/{sessionId}/close", "financialMutation": true, "idempotencyKeyRequired": true, "requestDto": null, "responseDto": "GameSessionDto" },
    { "operation": "listSessionPlayers", "method": "GET", "path": "/api/v1/game-sessions/{sessionId}/players", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": null, "responseDto": "SessionPlayerDto[]" },
    { "operation": "getSessionRoster", "method": "GET", "path": "/api/v1/game-sessions/{sessionId}/roster", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": null, "responseDto": "SessionRosterDto" },
    { "operation": "listPendingInvites", "method": "GET", "path": "/api/v1/game-sessions/{sessionId}/invites", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": null, "responseDto": "PendingInviteDto[]" },
    { "operation": "createInvite", "method": "POST", "path": "/api/v1/game-sessions/{sessionId}/invites", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": "CreateInviteRequest", "responseDto": "InviteDto" },
    { "operation": "cancelInvite", "method": "DELETE", "path": "/api/v1/game-sessions/{sessionId}/invites/{inviteId}", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": null, "responseDto": null },
    { "operation": "createManualDeposit", "method": "POST", "path": "/api/v1/game-sessions/{sessionId}/deposits", "financialMutation": true, "idempotencyKeyRequired": true, "requestDto": "CreateManualDepositRequest", "responseDto": "DepositDto" },
    { "operation": "adjustPlayerBalance", "method": "POST", "path": "/api/v1/game-sessions/{sessionId}/players/{membershipId}/balance-adjustments", "financialMutation": true, "idempotencyKeyRequired": true, "requestDto": "AdjustPlayerBalanceRequest", "responseDto": "SessionRosterPlayerDto" },
    { "operation": "previewDealerCashOut", "method": "GET", "path": "/api/v1/game-sessions/{sessionId}/players/{membershipId}/cashout-preview", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": null, "responseDto": "CashOutPreviewResponse" },
    { "operation": "startDealerCashOut", "method": "POST", "path": "/api/v1/game-sessions/{sessionId}/players/{membershipId}/cashouts", "financialMutation": true, "idempotencyKeyRequired": true, "requestDto": "DealerCashOutRequest", "responseDto": "CashOutResponse|null" },
    { "operation": "removeGameSession", "method": "DELETE", "path": "/api/v1/game-sessions/{sessionId}", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": null, "responseDto": "SessionRemovalDto" },
    { "operation": "reportPayoutEvent", "method": "POST", "path": "/api/v1/payout-events", "financialMutation": true, "idempotencyKeyRequired": true, "requestDto": "PayoutEventDto", "responseDto": "PayoutEventAckDto" },
    { "operation": "acknowledgePayoutEvent", "method": "POST", "path": "/api/v1/payout-events/{operationId}/{sequenceNumber}/ack", "financialMutation": true, "idempotencyKeyRequired": true, "requestDto": "PayoutEventAckDto", "responseDto": null },
    { "operation": "listOpenPayoutOperations", "method": "GET", "path": "/api/v1/payout-operations/open", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": null, "responseDto": "PayoutOperationDto[]" },
    { "operation": "retryCashout", "method": "POST", "path": "/api/v1/cashouts/{operationId}/retry", "financialMutation": true, "idempotencyKeyRequired": true, "requestDto": "RetryCashoutRequest", "responseDto": "PayoutOperationDto" },
    { "operation": "reconcilePayoutOperation", "method": "POST", "path": "/api/v1/payout-operations/{operationId}/reconcile", "financialMutation": true, "idempotencyKeyRequired": true, "requestDto": "ReconcileOperationRequest", "responseDto": "CashOutResponse" },
    { "operation": "settleCashOut", "method": "POST", "path": "/api/v1/cashouts/{cashOutId}/settle", "financialMutation": true, "idempotencyKeyRequired": true, "requestDto": "CashOutSettlementRequest", "responseDto": "CashOutResponse" },
    { "operation": "listOpenCashOuts", "method": "GET", "path": "/api/v1/cashouts/open", "financialMutation": false, "idempotencyKeyRequired": false, "requestDto": null, "responseDto": "OpenCashOutDto[]" }
  ],
  "enumDefinitions": {
    "GameSessionState": ["created", "open", "closing", "closed"],
    "SessionPlayerState": ["invited", "open", "closed"]
  },
  "dtoDefinitions": {
    "PayoutExecutorStatusDto": { "executorInstanceId": "guid", "isReady": "bool", "hasActiveOperation": "bool", "activeOperationId": "guid|null", "status": "string", "observedAt": "utcDateTimeOffset" },
    "GameSessionDto": { "sessionId": "guid", "gameType": "string", "feePercent": "decimal", "state": "GameSessionState", "playerCount": "int32", "totalDepositedGil": "int64", "payoutState": "string", "reconciliationState": "string", "createdAt": "utcDateTimeOffset", "openedAt": "utcDateTimeOffset|null", "closedAt": "utcDateTimeOffset|null", "maxPlayers": "int32|null" },
    "SessionPlayerDto": { "playerId": "guid", "sessionId": "guid", "characterName": "string", "homeWorld": "string", "state": "SessionPlayerState", "depositedGil": "int64", "payoutGil": "int64|null", "payoutState": "string", "reconciliationState": "string", "joinedAt": "utcDateTimeOffset" },
    "SessionRosterPlayerDto": { "membershipId": "guid", "sessionId": "guid", "characterName": "string", "homeWorld": "string", "tokens": "int64", "bettingLocked": "bool", "payoutState": "string", "reconciliationState": "string", "joinedAt": "utcDateTimeOffset" },
    "PendingInviteDto": { "inviteId": "guid", "sessionId": "guid", "characterName": "string", "homeWorld": "string", "initialBalanceGil": "int64", "createdAt": "utcDateTimeOffset", "expiresAt": "utcDateTimeOffset" },
    "SessionRosterDto": { "sessionId": "guid", "players": "SessionRosterPlayerDto[]", "pendingInvites": "PendingInviteDto[]", "observedAt": "utcDateTimeOffset" },
    "AdjustPlayerBalanceRequest": { "amountGil": "int64" },
    "DealerCashOutRequest": { "confirmAllAvailable": "bool", "confirmNetZero": "bool", "expectedGross": "int64", "expectedFee": "int64", "expectedNet": "int64" },
    "SessionRemovalDto": { "sessionId": "guid", "mode": "string" },
    "CashOutPreviewResponse": { "gross": "int64", "feePercent": "decimal", "fee": "int64", "net": "int64", "netIsZero": "bool", "legs": "CashOutLegPreview[]" },
    "CashOutResponse": { "id": "guid", "sessionId": "guid", "gross": "int64", "feePercent": "decimal", "fee": "int64", "net": "int64", "status": "string", "paidGross": "int64", "paidNet": "int64", "legs": "PayoutLegResponse[]", "createdAt": "utcDateTimeOffset" },
    "DepositDto": { "depositId": "guid", "sessionId": "guid", "playerId": "guid", "amountGil": "int64", "idempotencyKey": "guid", "recordedAt": "utcDateTimeOffset" },
    "PayoutOperationDto": { "operationId": "guid", "legId": "guid", "sessionId": "guid", "characterName": "string", "homeWorld": "string", "amountGil": "int64", "state": "PayoutOperationState", "lastErrorCode": "string|null", "lastErrorMessage": "string|null", "updatedAt": "utcDateTimeOffset" },
    "PayoutEventDto": { "operationId": "guid", "legId": "guid", "sequenceNumber": "int64", "pluginInstanceId": "guid", "eventType": "PayoutEventType", "characterName": "string", "homeWorld": "string", "amountGil": "int64", "occurredAt": "utcDateTimeOffset", "errorCode": "string|null", "errorMessage": "string|null", "isAmbiguous": "bool" }
  },
