  "hub": {
    "path": "/hubs/plugin",
    "serverToPlugin": [
      { "name": "RefreshDealerSessions", "payload": null },
      { "name": "QueuePayoutLeg", "payloadDto": "PayoutLegDto" },
      { "name": "CancelPayoutOperation", "payloadDto": "CancelPayoutOperationDto" },
      { "name": "RequestPayoutReconciliation", "payloadDto": "ReconciliationRequestDto" },
      { "name": "SessionClosed", "payload": "10000000-0000-0000-0000-000000000001" },
      { "name": "DealerAuthorizationRevoked", "payload": "authorizationRevoked" },
      { "name": "ReconnectRequired", "payload": "tokenRotated" }
    ],
    "pluginToServer": [
      { "name": "ReportDepositStatus", "arguments": ["10000000-0000-0000-0000-000000000001", "20000000-0000-0000-0000-000000000002", "23000000-0000-0000-0000-000000000002", "succeeded", null] },
      { "name": "ReportDropboxStatus", "payloadDto": "DropboxStatusDto" },
      { "name": "ReportOutgoingTradeStatus", "payloadDto": "PayoutOperationDto" },
      { "name": "ReportOutboxStatus", "arguments": [0, "2026-08-05T12:10:00+00:00"] }
    ]
  },
  "idempotency": {
    "header": "Idempotency-Key",
    "format": "UUID",
    "retryRule": "Reuse the same UUID for every HTTP attempt of one logical mutation and clear it only after a successful response.",
    "payoutEventRule": "Deterministic UUID derived from contract purpose, operationId, and sequenceNumber. Payout acknowledgments use a separate purpose namespace."
  }
}
