      { "name": "SessionClosed", "payload": "10000000-0000-0000-0000-000000000001" },
      { "name": "DealerAuthorizationRevoked", "payload": "authorizationRevoked" },
      { "name": "ReconnectRequired", "payload": "tokenRotated" },
      { "name": "BlackjackStateChanged", "payloadDto": "BlackjackTableDto" }
    ],
